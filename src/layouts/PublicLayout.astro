---
import {ClientRouter} from 'astro:transitions';
import {site,href} from '../lib/site';
import '../styles/public.css';
const {title=site.name, description=site.description, home=false, article=false}=Astro.props;
const nav=[['','首页'],['archive/','文章'],['anime/','追番'],['music/','音乐'],['space/','空间'],['links/','收藏夹']];
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/><meta name="theme-color" content="#101322"/>
  <title>{title===site.name?`${title} · 月面来信`:`${title} · ${site.name}`}</title>
  <link rel="canonical" href={canonical}/><link rel="icon" href={href('favicon.svg')}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(href('art/moon-observatory.webp'),Astro.site)}/>
  <ClientRouter/>
</head>
<body class:list={{'is-home':home}} data-base={href('')}>
  <a class="skip" href="#main">跳到正文</a>
  <header class="masthead">
    <a class="wordmark" href={href('')}><span class="moon-mark" aria-hidden="true">☾</span><span>{site.name}<small>UNFINISHED MEMORIES</small></span></a>
    <nav class="main-nav" aria-label="主导航">{nav.map(([path,label])=><a href={href(path)} aria-current={Astro.url.pathname===href(path)?'page':undefined}>{label}</a>)}</nav>
    <button class="nav-toggle" type="button" aria-label="收起导航" aria-expanded="true" data-nav-toggle>⌃</button>
    <button class="settings-toggle" type="button" data-settings-open aria-label="打开显示设置">☷</button>
  </header>
  <main id="main"><slot/></main>
  <footer class="footer"><a href={href('')}>{site.name}<span>故事还在继续。</span></a><div><a href={href('credits/')}>素材与致谢</a><a href={href('archive/')}>翻阅手账 ↗</a></div><small>© {new Date().getFullYear()} · MADE OF LITTLE MOMENTS</small></footer>
  <aside class="audio-dock" transition:persist="public-audio" aria-label="音乐播放控制">
    <audio id="public-audio" preload="none"></audio>
    <button type="button" data-audio-toggle aria-label="播放音乐">▶</button>
    <div><b data-track-title>月沿散步</b><span data-audio-state role="status">点击播放</span></div>
    <button type="button" data-audio-next aria-label="下一首">↠</button><a href={href('music/')} aria-label="打开音乐馆">↗</a>
  </aside>
  <dialog class="display-settings" aria-labelledby="settings-title"><form method="dialog"><button class="close" aria-label="关闭设置">×</button></form><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2 id="settings-title">按你的节奏。</h2>
    <label>页面动效<select data-motion-setting><option value="on">轻柔演出</option><option value="off">关闭动效</option></select></label>
    <label>正文大小 <output data-font-output>19 px</output><input data-font-setting type="range" min="16" max="28" step="1" value="19"/></label>
    <label>阅读宽度 <output data-width-output>860 px</output><input data-width-setting type="range" min="620" max="1280" step="20" value="860"/></label>
    <label class="check"><input type="checkbox" data-hide-dock/>隐藏浮动播放器（F8）</label>
  </dialog>
  <script is:inline src={href('public-runtime.js')} defer></script>
</body></html>
