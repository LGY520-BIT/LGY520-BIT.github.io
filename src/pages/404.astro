---
import { site } from '../config';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title={`这一页，暂时迷路了 · ${site.name}`}><section class="not-found container"><span>404<span style="font-size:35px">✳</span></span><h1>这一页，暂时迷路了。</h1><p>也许故事搬了家，也许这条小径还没有被写下。</p><a href="/" class="button button-primary">回到熟悉的地方 <Icon name="arrow" size={18}/></a></section></Layout>
