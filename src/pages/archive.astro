---
import { site } from '../config';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, categories } from '../lib/posts';
const posts = await getPosts();
---
<Layout title={`文章归档 · ${site.name}`} description="沿着时间与兴趣，翻阅关于生活、技术、设计和阅读的笔记。">
  <section class="page-intro container"><span class="eyebrow">THE ARCHIVE</span><h1>写下的，都是经过<span class="heading-dot">.</span></h1><p>把零散的思绪整理成篇，<br/>在时间里，留下一点自己的痕迹。</p><span class="intro-flower" aria-hidden="true">✳</span></section>
  <section class="archive-wrap container" aria-label="全部文章"><div class="filter-bar"><button class="filter-chip active" data-filter="all" aria-pressed="true">全部 <span>{posts.length}</span></button>{categories.map(c=><button class="filter-chip" data-filter={c} aria-pressed="false">{c}</button>)}</div><div class="archive-summary"><span>共 <strong id="post-count">{posts.length}</strong> 篇文字 · 按时间倒序</span><span id="active-tag" hidden></span></div><div class="posts-list">{posts.map((post,i)=><PostCard post={post} index={i}/>)}</div><p class="empty-state" hidden>还没有找到这类文章。换个分类，继续逛逛吧。</p></section>
</Layout>
