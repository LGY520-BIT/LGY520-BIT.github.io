---
import '../styles/media-picker.css';
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import links from '../data/links.json';
import { getPosts } from '../lib/posts';
import '../styles/space.css';
const posts = await getPosts();
---
<Layout title={`个人空间 · ${profile.siteName}`} description={profile.bio}>
  <section class="space-shell container" data-space-page>
    <div class="space-cover"><img src={profile.cover} alt="个人空间封面" width="1600" height="640" fetchpriority="high"/><div class="space-cover-label"><span>MY LITTLE UNIVERSE</span><strong>{profile.siteName}</strong><p>往事有回声，故事还未完。</p></div><span class="space-cover-stamp" aria-hidden="true">日常<br/>収集中</span></div>
    <div class="space-identity"><div class="space-avatar"><img src={profile.avatar} alt={`${profile.displayName}的空间头像`} width="160" height="160"/></div><div class="space-identity-copy"><span class="space-kicker">PERSONAL SPACE · 个人空间</span><h1>{profile.displayName}</h1><p>{profile.signature}</p></div><button class="space-button space-edit" type="button" data-edit-profile hidden>✎ 编辑我的空间</button></div>
    <nav class="space-tabs" aria-label="个人空间导航"><a href="/space/" aria-current="page">我的主页</a><a href="/archive/">日记本</a><a href="/anime/">追番记录</a><a href="/music/">音乐盒</a><a href="/links/">网址收藏</a></nav>
    <div class="space-columns"><aside class="space-card space-about"><span class="space-kicker">ABOUT ME</span><h2>关于我</h2><p class="space-bio">{profile.bio}</p><p class="space-location">⌖ {profile.location || '位置未填写'}</p><div class="space-tags">{profile.interests.map(tag=><span>{tag}</span>)}</div>{profile.sampleMode && <p class="space-hint">初始资料 · 可编辑替换</p>}</aside><div class="space-main"><section class="space-card"><div class="space-section-heading"><div><span class="space-kicker">LIFE IN LITTLE PIECES</span><h2>把喜欢的日常，收进小宇宙</h2></div><span aria-hidden="true">✦</span></div><div class="space-metrics"><a href="/archive/"><strong>{posts.length}</strong><span>篇公开日记</span></a><a href="/links/"><strong>{links.items.length}</strong><span>个喜欢的网址</span></a><a href="/anime/"><strong>番</strong><span>故事放映中</span></a></div></section><section class="space-card space-notebook"><span class="space-kicker">A NOTE TO THE WORLD</span><h2>此刻的心情</h2><blockquote>{profile.signature}</blockquote><p>不必把生活写成履历。喜欢的歌、想看的番和偶然发现的好网站，也都是关于你的线索。</p><div class="space-small-links"><a href="/music/">♫ 听一首歌</a><a href="/links/">↗ 逛逛收藏夹</a></div></section></div></div>
    <p class="space-local-note" data-space-local-note role="status" aria-live="polite"></p><noscript><p class="space-hint">编辑资料需启用 JavaScript，并使用本机地址。</p></noscript>
  </section>
  <dialog class="space-dialog" data-profile-dialog aria-labelledby="profile-editor-title"><form data-profile-form><div class="space-dialog-heading"><div><span class="space-kicker">MAKE IT YOURS</span><h2 id="profile-editor-title">编辑我的空间</h2></div><button type="button" class="space-icon-button" data-close-editor aria-label="关闭资料编辑">×</button></div><div class="space-form-grid"><label>站名<input name="siteName" maxlength="32" required/></label><label>昵称<input name="displayName" maxlength="40" required/></label></div><label>个性签名<input name="signature" maxlength="160"/></label><label>自我介绍<textarea name="bio" rows="4" maxlength="1200"></textarea></label><div class="space-form-grid"><label>位置<input name="location" maxlength="80" placeholder="想公开的位置，或者留空"/></label><label>兴趣标签<input name="interests" maxlength="250" placeholder="动漫，音乐，生活（最多 12 个）"/></label></div><div class="space-image-fields"><label>头像图片地址<input name="avatar" required placeholder="/images/… 或 HTTPS 图片地址"/><button type="button" class="space-button" data-profile-media-choice="avatar">从素材库选择</button><input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-image-upload="avatar" aria-label="上传头像"/></label><label>空间封面地址<input name="cover" required placeholder="/images/… 或 HTTPS 图片地址"/><button type="button" class="space-button" data-profile-media-choice="cover">从素材库选择</button><input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-image-upload="cover" aria-label="上传空间封面"/></label></div><p class="space-hint">支持 PNG、JPEG、WebP、GIF，最大 10 MB。</p><p class="space-status" role="status" aria-live="polite" data-editor-status></p><div class="space-dialog-actions"><button type="button" class="space-button" data-export-profile>导出资料备份</button><button type="submit" class="space-button space-primary">保存资料</button></div></form></dialog>
  <script is:inline src="/space-editor.js" defer></script>
</Layout>
