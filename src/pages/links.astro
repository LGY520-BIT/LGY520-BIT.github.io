---
import '../styles/media-picker.css';
import '../styles/bookmark-transfer.css';
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import collection from '../data/links.json';
import { safeSpaceUrl, safeSpaceImage } from '../lib/public-urls.mjs';
import '../styles/space.css';
import '../styles/image-picker.css';
import '../styles/bookmark-library.css';
const items = collection.items.filter(item => safeSpaceUrl(item.url)).sort((a,b)=>Number(b.pinned)-Number(a.pinned));
const categories = [...new Set(items.map(item=>item.category))];
---
<Layout title={`喜欢的网址 · ${profile.siteName}`} description="收藏喜欢的网站，为每一次灵感留下入口。">
  <section class="space-shell links-room container" data-links-page data-links-layout="grid">
    <header class="links-hero"><div><span class="space-kicker">A POCKET FULL OF PORTALS</span><h1>喜欢的地方，<br/>随时都能抵达<span>↗</span></h1><p>把偶然遇见的好网站，认真地收进收藏夹。</p></div><div class="links-hero-art" aria-hidden="true"><span>WWW.</span><b>灵感<br/>传送门</b><i>好きなものだけ</i></div></header>
    <div class="links-toolbar"><label class="links-search">⌕ <input type="search" maxlength="120" placeholder="搜索名称、简介或网址" aria-label="搜索网址收藏" data-links-search/></label><div class="links-library-actions"><button type="button" class="space-button space-primary" data-add-link hidden>＋ 收藏一个网址</button><button type="button" class="space-button" data-links-import hidden>导入书签</button><input type="file" data-links-import-file accept=".json,.html,.htm,application/json,text/html" aria-label="选择收藏备份或浏览器书签文件" hidden/><button type="button" class="space-button" data-links-export>导出收藏</button><a class="space-button" href="/space/">我的空间</a></div></div>
    <div class="links-library-bar"><p class="links-library-results" data-links-results role="status" aria-live="polite">共 {items.length} 个喜欢的网址</p><div class="links-library-options"><label class="links-sort">排序<select data-links-sort aria-label="收藏排序"><option value="default">置顶优先</option><option value="title">名称</option><option value="site">网站</option></select></label><div class="links-view-switch" role="group" aria-label="收藏显示方式"><button type="button" data-links-view="grid" aria-pressed="true" title="卡片视图">▦ <span>卡片</span></button><button type="button" data-links-view="list" aria-pressed="false" title="列表视图">☰ <span>列表</span></button></div></div></div>
    <div class="links-filters" aria-label="按分类筛选"><button type="button" class="is-active" data-link-category="" aria-pressed="true">全部 <span data-links-count>{items.length}</span></button>{categories.map(category=><button type="button" data-link-category={category} aria-pressed="false">{category}</button>)}</div>
    <div class="links-grid" data-links-grid>{items.map(item=><article class="link-card" data-link-id={item.id} data-category={item.category} data-search={`${item.title} ${item.description} ${item.url}`.toLocaleLowerCase()}><a class="link-card-cover" data-link-image href={item.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" hidden={!safeSpaceImage(item.image)}>{safeSpaceImage(item.image) && <img src={safeSpaceImage(item.image)} alt="" width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>}</a><div class="link-card-top"><span class="link-letter" aria-hidden="true">{item.title.slice(0,1).toUpperCase()}</span><span class="link-category">{item.category}</span>{item.pinned && <span class="link-pin" aria-label="已置顶">★</span>}</div><h2><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}<span aria-hidden="true">↗</span></a></h2><p>{item.description || '为下次灵感，留一扇门。'}</p><div class="link-card-bottom"><span>{new URL(item.url).hostname}</span><button type="button" class="space-text-button" data-edit-link={item.id} hidden aria-label={`编辑${item.title}`}>编辑</button></div></article>)}</div><p class="links-empty space-card" data-links-empty hidden>这片星图还没有匹配的网址。换个关键词，或者收藏一个新网站。</p><p class="space-local-note" role="status" aria-live="polite"></p><noscript><p class="space-hint">搜索、分类和编辑需启用 JavaScript。</p></noscript>
    <script is:inline type="application/json" data-links-library-data set:html={JSON.stringify(collection).replace(/</g, '\\u003c')}/>
  </section>
  <dialog class="space-dialog" data-link-dialog aria-labelledby="link-editor-title"><form data-link-form><div class="space-dialog-heading"><div><span class="space-kicker">ONE MORE FAVORITE</span><h2 id="link-editor-title">收藏一个网址</h2></div><button type="button" class="space-icon-button" data-close-editor aria-label="关闭网址编辑">×</button></div><label>网站名称<input name="title" maxlength="80" required/></label><label>网址<input name="url" type="url" maxlength="2048" placeholder="https://" required/></label><p class="link-duplicate-warning" data-link-duplicate-warning role="status" hidden></p><label>一句话介绍<textarea name="description" rows="3" maxlength="280"></textarea></label><section class="image-picker link-image-picker" data-image-picker aria-label="收藏图片"><input type="hidden" name="image"/><div class="image-picker-visual"><img data-image-preview alt="收藏图片预览" hidden/><span class="image-picker-empty" data-image-empty>为这个网址选一张图片</span></div><div class="image-picker-copy"><strong>收藏图片 · 可选</strong><input type="file" accept="image/png,image/jpeg,image/webp,image/gif" data-image-file aria-label="选择收藏图片" hidden/><div class="image-picker-actions"><button type="button" class="space-button" data-image-choose>选择图片</button><button type="button" class="space-button" data-image-library>从素材库选择</button><button type="button" class="space-button" data-image-remove hidden>移除图片</button></div><p class="image-picker-status" data-image-status role="status" aria-live="polite"></p></div></section><label>分类<input name="category" maxlength="30" list="link-categories" value="灵感" required/></label><datalist id="link-categories">{categories.map(category=><option value={category}/>)}</datalist><label class="space-check"><input name="pinned" type="checkbox"/> 置顶到收藏夹前面</label><p class="space-status" role="status" aria-live="polite" data-editor-status></p><div class="space-dialog-actions"><button type="button" class="space-button space-danger" data-delete-link hidden>删除这条收藏</button><button type="button" class="space-button" data-export-link-draft>导出当前草稿</button><button type="submit" class="space-button space-primary">保存网址</button></div></form></dialog>
  <dialog class="space-dialog bookmark-import-dialog" data-links-import-dialog aria-labelledby="links-import-title"><div class="space-dialog-heading"><div><span class="space-kicker">BRING YOUR FAVORITES HOME</span><h2 id="links-import-title">导入你的书签</h2></div><button type="button" class="space-icon-button" data-links-import-close aria-label="关闭书签导入">×</button></div><p class="bookmark-import-note">选择要留下的网址。导入仅添加新收藏，不会覆盖已有条目。</p><p class="bookmark-import-summary" data-links-import-summary></p><div class="bookmark-import-selection"><button type="button" class="space-button" data-links-import-select-all>全选</button><span>勾选后再导入</span></div><div class="bookmark-import-list" data-links-import-list aria-label="待导入书签"></div><p class="space-status" data-links-import-status role="status" aria-live="polite"></p><div class="space-dialog-actions"><button type="button" class="space-button" data-links-import-cancel>取消</button><button type="button" class="space-button space-primary" data-links-import-confirm>导入选中项</button></div></dialog>
  <dialog class="space-dialog bookmark-transfer-dialog" data-links-transfer-dialog aria-labelledby="links-transfer-title"><div class="space-dialog-heading"><h2 id="links-transfer-title" data-links-transfer-title>备份收藏夹</h2><button type="button" class="space-icon-button" data-links-transfer-close aria-label="关闭备份与导入">×</button></div><p role="status" data-links-transfer-status></p><div class="bookmark-transfer-files" data-links-transfer-files></div><label>JSON / HTML 内容<textarea data-links-transfer-text aria-label="书签备份内容" rows="10" maxlength="2097152" spellcheck="false"></textarea></label><div class="space-dialog-actions"><button type="button" class="space-button" data-links-transfer-file>选择文件</button><button type="button" class="space-button space-primary" data-links-transfer-preview>读取并预览</button></div></dialog>
  <script is:inline src="/space-editor.js" defer></script>
</Layout>
