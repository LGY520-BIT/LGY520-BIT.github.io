---
import { site } from '../config';
import Layout from '../layouts/Layout.astro';
---
<Layout title={`月光音乐室 · ${site.name}`} description="给喜欢的旋律，一个独立的小房间。本地播放、黑胶唱片、同步歌词和你亲手挑选的封面。">
  <section class="music-room container" data-music-room>
    <header class="music-room__intro">
      <div><a class="music-room__back" href="/">← 回到日常</a><span class="music-room__eyebrow">私の音楽室 / MOONLIGHT RECORDS</span><h1>把耳机戴上，<br/>世界先按<span>暂停。</span><i aria-hidden="true">♫</i></h1><p>不赶时间，不必切歌。<br/>把今天的心情，调到自己喜欢的频率。</p></div>
      <div class="music-room__ticket" aria-hidden="true"><span>ADMIT ONE</span><strong>只属于你的<br/>小小演唱会</strong><div>MOONLIGHT<br/><b>VOL. 01</b></div><small>GOOD MUSIC / GOOD MOOD</small></div>
    </header>
  </section>
</Layout>
