---
import { site } from '../config';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DreamscapeCard from '../components/DreamscapeCard.astro';
---
<Layout title={`创作与记录 · ${site.name}`} description="把灵感接入现实，从这个月夜主题博客开始，展示已经实现的小小创造。">
  <section class="page-intro container">
    <span class="eyebrow">CREATIVE SIGNALS · MADE WITH CARE</span>
    <h1>想象上线，也认真落地<span class="heading-dot">.</span></h1>
    <p>把脑海里的小小闪光，变成可以打开、使用和分享的东西。<br/>频道还在生长，从第一件作品开始，慢慢收藏每次创造。</p>
    <span class="intro-flower" aria-hidden="true">✦</span>
  </section>
  <section class="dreamscape-project container" id="dreamscape" aria-label="第一款原创壁纸"><DreamscapeCard /><p>昼夜光影、人物微动、花瓣与时钟，在手账身后静静流动。</p><small>壁纸制作：本站作者 · 原型参考：黑嘴酱 / KumengScreen · <a href="/wallpapers/kumeng/NOTICES.txt">来源与许可说明 ↗</a></small></section>
  <section class="project-grid container" aria-label="已经实现的项目">
    <article class="project-card">
      <a href="/" class="project-art cosmic-project-art" tabindex="-1" aria-hidden="true" style="background-image:linear-gradient(180deg,rgba(17,14,48,.12),rgba(17,14,48,.72)),url('/images/cosmic/story.webp');background-size:cover;background-position:center">
        <div class="project-preview"><div class="mini-brand">✦ {site.name}</div><img class="mini-image" src="/images/cosmic/story.webp" width="1200" height="676" alt="" loading="lazy"/><div class="mini-heading">月光入站，<br/>故事未完。</div><div class="mini-line"></div><div class="mini-line" style="width:34%"></div></div>
      </a>
      <div class="project-card-copy"><span class="project-status"><span class="status-dot"></span>已实现 · 你正在访问</span><h2>{site.name} · 个人博客</h2><p>以阅读为核心的个人博客，穿上一层《超时空辉夜姬！》的非官方粉丝主题。支持 Markdown、分类标签、全文搜索、深浅色模式与响应式阅读。</p><div class="tag-cloud"><span>Astro</span><span>Markdown</span><span>月夜主题</span></div><a class="text-link" href="/">进入这个频道 <Icon name="diagonal" size={16}/></a></div>
    </article>
    <article class="project-card">
      <a href="/rss.xml" class="project-art rss-art" tabindex="-1" aria-hidden="true"><div class="project-preview"><Icon name="rss" size={30}/><div class="mini-heading">把更新，调到自己的频率。</div><div class="mini-line" style="width:90%"></div><div class="mini-line" style="width:70%"></div><div class="mini-line" style="width:80%"></div><div class="mini-line" style="width:45%"></div></div></a>
      <div class="project-card-copy"><span class="project-status"><span class="status-dot"></span>已实现 · 随文章一起更新</span><h2>文字信号 · RSS</h2><p>把订阅地址加入自己的阅读器，在喜欢的时候接收新文章，让阅读保持自己的节奏。</p><div class="tag-cloud"><span>RSS 2.0</span><span>开放订阅</span><span>没有算法</span></div><a class="text-link" href="/rss.xml">接收文章更新 <Icon name="diagonal" size={16}/></a></div>
    </article>
  </section>
  <div class="projects-note container">下一个小作品，正在慢慢酝酿。主题参考与媒体来源见<a href="/credits/">致谢与素材说明</a>。</div>
</Layout>
